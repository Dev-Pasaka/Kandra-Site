{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kandra-site",
  "compatibility_date": "2026-07-23",
  // The site is a fully static export (`output: "export"` in next.config.ts) served from `out/` —
  // no OpenNext/SSR adapter. Keep this file: without it, Cloudflare's Next.js auto-detection
  // routes the build through `opennextjs-cloudflare`, which expects a server build a static export
  // never produces (the ENOENT on deploy).
  //
  // worker/index.ts is the community backend: the /api JSON API, uploaded media under /media,
  // and server-rendered community posts under /community/p. Only those paths run it
  // (`run_worker_first`); every other path is served straight from `out/` as before.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/media/*", "/community/p/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kandra-site",
      // Created with `npx wrangler d1 create kandra-site` (region EEUR).
      "database_id": "22c92432-8813-48b6-8e30-e100cfa91df6",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    // Images and videos uploaded for community posts (worker/media.ts).
    { "binding": "MEDIA", "bucket_name": "kandra-media" }
  ],
  "vars": {
    // Public OAuth app id (github.com/settings/developers). The secret is set with
    // `npx wrangler secret put GITHUB_CLIENT_SECRET`, never here.
    "GITHUB_CLIENT_ID": "Ov23liq3zePz6jCmTyLO",
    "ADMIN_GITHUB_LOGINS": "Dev-Pasaka"
  },
  "observability": { "enabled": true }
}
